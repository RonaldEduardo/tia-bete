<script setup lang="ts">
import { computed, onMounted, reactive, ref } from 'vue'
type Food={id:string,name:string,carbsPer100g:number};type Meal={id:string,totalCarbohydrates:number,items:{foodId:string,foodName:string,grams:number,carbohydrates:number}[]}
const foods=ref<Food[]>([]),meals=ref<Meal[]>([]),error=ref(''),success=ref(''),loading=ref(false),food=reactive({name:'',carbsPer100g:''}),meal=reactive({date:'',time:'',items:[] as {foodId:string,grams:string}[]}),zone=ref('UTC')
const total=computed(()=>meal.items.reduce((sum,item)=>{const food=foods.value.find(value=>value.id===item.foodId);return sum+(food?Number(item.grams||0)*food.carbsPer100g/100:0)},0))
const load=async()=>{loading.value=true;try{const [savedFoods,savedMeals]=await Promise.all([$fetch<Food[]>('/api/foods'),$fetch<Meal[]>('/api/meals')]);foods.value=savedFoods;meals.value=savedMeals}catch{error.value='Não foi possível carregar os dados locais.'}finally{loading.value=false}}
const add=()=>meal.items.push({foodId:foods.value[0]?.id||'',grams:''})
const saveFood=async()=>{try{await $fetch('/api/foods',{method:'POST',body:food});food.name='';food.carbsPer100g='';success.value='Alimento salvo localmente.';await load()}catch{error.value='Não foi possível salvar o alimento.'}}
const saveMeal=async()=>{try{await $fetch('/api/meals',{method:'POST',body:{...meal,timeZone:zone.value}});success.value='Refeição salva localmente.';meal.items=[];await load()}catch{error.value='Não foi possível salvar a refeição.'}}
onMounted(()=>{const now=new Date();meal.date=now.toISOString().slice(0,10);meal.time=now.toTimeString().slice(0,5);zone.value=Intl.DateTimeFormat().resolvedOptions().timeZone||'UTC';void load()})
</script>
<template><section id="alimentacao" class="insulin-section"><div class="section-heading"><div><p class="eyebrow">Alimentação</p><h2>Alimentos e refeições</h2></div></div><p v-if="loading" role="status">Atualizando dados locais…</p><StatusIndicator v-if="success" tone="success">{{ success }}</StatusIndicator><StatusIndicator v-if="error" tone="warning">{{ error }}</StatusIndicator><AppCard><h2>Cadastrar alimento</h2><AppInput id="food-name" v-model="food.name" label="Nome"/><AppInput id="food-carbs" v-model="food.carbsPer100g" label="Carboidratos por 100 g" type="number" min="0" step="any"/><AppButton @click="saveFood">Salvar alimento</AppButton></AppCard><AppCard><h2>Montar refeição</h2><p>Total: {{ total }} g de carboidratos</p><div v-for="(item,index) in meal.items" :key="index" class="form-grid"><select v-model="item.foodId"><option v-for="value in foods" :key="value.id" :value="value.id">{{ value.name }}</option></select><AppInput :id="`meal-grams-${index}`" v-model="item.grams" label="Gramas" type="number" min="0" step="any"/></div><AppButton variant="secondary" @click="add">Adicionar alimento</AppButton><div class="form-grid"><AppInput id="meal-date" v-model="meal.date" label="Data" type="date"/><AppInput id="meal-time" v-model="meal.time" label="Horário" type="time"/></div><AppButton :disabled="!meal.items.length" @click="saveMeal">Salvar refeição</AppButton></AppCard><AppCard v-for="value in meals" :key="value.id"><h2>{{ value.totalCarbohydrates }} g de carboidratos</h2><p>{{ value.items.map(item => `${item.foodName}: ${item.grams} g`).join(' · ') }}</p><details><summary>Ver detalhes</summary><p v-for="item in value.items" :key="item.foodId">{{ item.foodName }} — {{ item.carbohydrates }} g</p></details></AppCard></section></template>
