import { mkdtempSync, readFileSync, rmSync } from 'node:fs'
import { DatabaseSync } from 'node:sqlite'
import { tmpdir } from 'node:os'
import { join, resolve } from 'node:path'
import { afterEach, describe, expect, it } from 'vitest'
import { SqliteMealRepository } from '../../../server/infrastructure/foods/sqliteFoodMealRepositories'
const sql=readFileSync(resolve('server/infrastructure/foods/migrations/005_create_foods_meals.sql'),'utf8');const directories:string[]=[]
afterEach(()=>directories.splice(0).forEach(x=>rmSync(x,{recursive:true,force:true})))
describe('SqliteMealRepository',()=>it('keeps the persisted nutritional snapshot after the food changes and restart', async () => { const dir=mkdtempSync(join(tmpdir(),'food-'));directories.push(dir);const path=join(dir,'food.sqlite');const repository=new SqliteMealRepository(path,[{version:'005',sql}]);await repository.save({id:'meal-snapshot',occurredAt:'2026-11-04T08:00:00.000Z',createdAt:'2026-11-04T08:01:00.000Z',timeZone:'UTC',totalCarbohydrates:30,items:[{foodId:'food-1',foodName:'Alimento sintético',grams:150,carbsPer100g:20,carbohydrates:30}]});const database=new DatabaseSync(path);database.prepare('INSERT INTO foods VALUES(?,?,?,?)').run('food-1','Alimento sintético',20,'2026-11-04T07:00:00.000Z');database.prepare('UPDATE foods SET carbs_per_100g=? WHERE id=?').run(40,'food-1');database.close();const restarted=new SqliteMealRepository(path,[{version:'005',sql}]);await expect(restarted.find('meal-snapshot')).resolves.toMatchObject({totalCarbohydrates:30,items:[{foodId:'food-1',foodName:'Alimento sintético',grams:150,carbsPer100g:20,carbohydrates:30}]}) })
  it('rolls back the meal when an item insert fails',async()=>{const dir=mkdtempSync(join(tmpdir(),'food-'));directories.push(dir);const repository=new SqliteMealRepository(join(dir,'food.sqlite'),[{version:'005',sql}]);await expect(repository.save({id:'meal-1',occurredAt:'2026-11-04T08:00:00.000Z',createdAt:'2026-11-04T08:01:00.000Z',timeZone:'UTC',totalCarbohydrates:10,items:[{foodId:'same',foodName:'A',grams:10,carbsPer100g:10,carbohydrates:1},{foodId:'same',foodName:'B',grams:10,carbsPer100g:10,carbohydrates:1}]})).rejects.toThrow();expect(await repository.list()).toEqual([])}))
