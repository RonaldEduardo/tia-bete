import{mkdirSync}from'node:fs';import{dirname}from'node:path';import{DatabaseSync}from'node:sqlite';import type{FoodRepository,MealRepository}from'../../../shared/application/foods/repositories';import type{Food}from'../../../shared/domain/foods/food';import type{Meal}from'../../../shared/domain/foods/meal';import type{SqliteMigration}from'../../infrastructure/glucose/sqliteGlucoseReadingRepository';
class Base{protected db:DatabaseSync;constructor(path:string,ms:SqliteMigration[]){mkdirSync(dirname(path),{recursive:true});this.db=new DatabaseSync(path);this.db.exec('CREATE TABLE IF NOT EXISTS schema_migrations(version TEXT PRIMARY KEY NOT NULL)');for(const m of ms)if(!this.db.prepare('SELECT version FROM schema_migrations WHERE version=?').get(m.version)){this.db.exec(m.sql);this.db.prepare('INSERT INTO schema_migrations VALUES(?)').run(m.version)}}}
export class SqliteFoodRepository extends Base implements FoodRepository{async save(f:Food){this.db.prepare('INSERT INTO foods VALUES(?,?,?,?)').run(f.id,f.name,f.carbsPer100g,f.createdAt)}async list(){return(this.db.prepare('SELECT * FROM foods').all()as any[]).map(x=>({id:x.id,name:x.name,carbsPer100g:x.carbs_per_100g,createdAt:x.created_at}))}}
export class SqliteMealRepository extends Base implements MealRepository{async save(m:Meal){this.db.prepare('INSERT INTO meals VALUES(?,?,?,?,?)').run(m.id,m.occurredAt,m.createdAt,m.timeZone,m.totalCarbohydrates);const q=this.db.prepare('INSERT INTO meal_items VALUES(?,?,?,?,?,?,?)');for(const i of m.items)q.run(m.id,i.foodId,i.foodName,i.grams,i.carbsPer100g,i.carbohydrates)}async list(){return(this.db.prepare('SELECT * FROM meals').all()as any[]).map(x=>this.map(x))}async find(id:string){const x=this.db.prepare('SELECT * FROM meals WHERE id=?').get(id)as any;return x&&this.map(x)}private map(x:any):Meal{const items=(this.db.prepare('SELECT * FROM meal_items WHERE meal_id=?').all(x.id)as any[]).map(i=>({foodId:i.food_id,foodName:i.food_name,grams:i.grams,carbsPer100g:i.carbs_per_100g,carbohydrates:i.carbohydrates}));return{id:x.id,occurredAt:x.occurred_at,createdAt:x.created_at,timeZone:x.time_zone,totalCarbohydrates:x.total_carbohydrates,items}}}
