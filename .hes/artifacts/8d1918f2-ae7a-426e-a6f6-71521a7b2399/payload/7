<script setup lang="ts">import{onMounted,reactive,ref,computed}from'vue';type Food={id:string,name:string,carbsPer100g:number};type Meal={id:string,totalCarbohydrates:number,occurredAt:string,items:any[]};const foods=ref<Food[]>([]),meals=ref<Meal[]>([]),error=ref(''),success=ref(''),loading=ref(false),food=reactive({name:'',carbsPer100g:''}),meal=reactive({date:'',time:'',items:[]as{foodId:string,grams:string}[]});const zone=ref('UTC');const total=computed(()=>meal.items.reduce((s,i)=>{const f=foods.value.find(x=>x.id===i.foodId);return s+(f?Number(i.grams||0)*f.carbsPer100g/100:0)},0));const load=async()=>{loading.value=true;try{[foods.value,meals.value]=await Promise.all([$fetch('/api/foods'),$fetch('/api/meals')])as any}catch{error.value='Não foi possível carregar os dados locais.'}finally{loading.value=false}};const add=()=>meal.items.push({foodId:foods.value[0]?.id||'',grams:''});const saveFood=async()=>{error.value='';try{await $fetch('/api/foods',{method:'POST',body:food});food.name='';food.carbsPer100g='';success.value='Alimento salvo localmente.';await load()}catch{error.value='Não foi possível salvar o alimento.'}};const saveMeal=async()=>{error.value='';try{await $fetch('/api/meals',{method:'POST',body:{...meal,timeZone:zone.value}});success.value='Refeição salva localmente.';meal.items=[];await load()}catch{error.value='Não foi possível salvar a refeição.'}};onMounted(()=>{const d=new Date();meal.date=d.toISOString().slice(0,10);meal.time=d.toTimeString().slice(0,5);zone.value=Intl.DateTimeFormat().resolvedOptions().timeZone||'UTC';load()})</script><template><section id="alimentacao" class="insulin-section"><div class="section-heading"><div><p class="eyebrow">Alimentação</p><h2>Alimentos e refeições</h2></div></div><p v-if="loading" role="status">Atualizando dados locais…</p><StatusIndicator v-if="success" tone="success">{{success}}</StatusIndicator><StatusIndicator v-if="error" tone="warning">{{error}}</StatusIndicator><AppCard><h2>Cadastrar alimento</h2><AppInput id="food-name" v-model="food.name" label="Nome"/><AppInput id="food-carbs" v-model="food.carbsPer100g" label="Carboidratos por 100 g" type="number" min="0" step="any"/><AppButton @click="saveFood">Salvar alimento</AppButton></AppCard><AppCard><h2>Montar refeição</h2><p>Total: {{total}} g de carboidratos</p><div v-for="(item,i) in meal.items" :key="i" class="form-grid"><select v-model="item.foodId"><option v-for="f in foods" :value="f.id">{{f.name}}</option></select><AppInput :id="`meal-grams-${i}`" v-model="item.grams" label="Gramas" type="number" min="0" step="any"/></div><AppButton variant="secondary" @click="add">Adicionar alimento</AppButton><div class="form-grid"><AppInput id="meal-date" v-model="meal.date" label="Data" type="date"/><AppInput id="meal-time" v-model="meal.time" label="Horário" type="time"/></div><AppButton :disabled="!meal.items.length" @click="saveMeal">Salvar refeição</AppButton></AppCard><AppCard v-for="m in meals" :key="m.id"><h2>{{m.totalCarbohydrates}} g de carboidratos</h2><p>{{m.items.map(i=>`${i.foodName}: ${i.grams} g`).join(' · ')}}</p><details><summary>Ver detalhes</summary><p v-for="i in m.items" :key="i.foodId">{{i.foodName}} — {{i.carbohydrates}} g</p></details></AppCard></section></template>
