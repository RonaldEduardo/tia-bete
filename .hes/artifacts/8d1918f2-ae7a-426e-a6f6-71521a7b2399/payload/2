import { calculateCarbohydrates } from './calculateCarbohydrates'
import { resolveLocalDateTime } from '../glucose/validateGlucoseReading'
export type MealItem={foodId:string,foodName:string,grams:number,carbsPer100g:number,carbohydrates:number}
export type Meal={id:string,occurredAt:string,createdAt:string,timeZone:string,items:MealItem[],totalCarbohydrates:number}
export type MealInput={date:string,time:string,timeZone:string,items:{foodId:string,grams:string}[]}
export type MealErrors=Partial<Record<'date'|'time'|'timeZone'|'items'|'localDateTime'|'id'|'createdAt','required'|'invalid'|'invalid-time-zone'|'nonexistent-local-time'|'ambiguous-local-time'>>
export const createMeal=(input:MealInput&{id:string,createdAt:string,foods:{id:string,name:string,carbsPer100g:number}[]}):{meal:Meal}|{errors:MealErrors}=>{const errors:MealErrors={};if(!input.date)errors.date='required';if(!input.time)errors.time='required';if(!input.items.length)errors.items='required';if(!input.id.trim())errors.id='required';if(Number.isNaN(Date.parse(input.createdAt)))errors.createdAt='invalid';const resolution=resolveLocalDateTime(input.date,input.time,input.timeZone);if('error'in resolution)errors.localDateTime=resolution.error;if(Object.keys(errors).length)return{errors};const items:MealItem[]=[];for(const item of input.items){const food=input.foods.find(food=>food.id===item.foodId);const grams=Number(item.grams);if(!food||!item.grams.trim()||!Number.isFinite(grams)||grams<=0){errors.items='invalid';continue}items.push({foodId:food.id,foodName:food.name,grams,carbsPer100g:food.carbsPer100g,carbohydrates:calculateCarbohydrates(grams,food.carbsPer100g)})}if(errors.items)return{errors};return{meal:{id:input.id,occurredAt:resolution.occurredAt,createdAt:new Date(input.createdAt).toISOString(),timeZone:input.timeZone,items,totalCarbohydrates:items.reduce((total,item)=>total+item.carbohydrates,0)}}}
