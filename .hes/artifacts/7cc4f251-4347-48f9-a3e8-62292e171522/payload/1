:root {
  --color-primary: #2563eb;
  --color-primary-soft: #e8f0ff;
  --color-background: #f8f7f3;
  --color-surface: #ffffff;
  --color-text: #182334;
  --color-text-secondary: #66758a;
  --color-border: #e3e7ed;
  --color-success: #267a58;
  --color-warning: #a56b20;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --radius-button: 12px;
  --radius-card: 16px;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--color-text);
  background: var(--color-background);
}

* { box-sizing: border-box; }
body { margin: 0; background: var(--color-background); }
button, input, select { font: inherit; }
button, a, input, select { -webkit-tap-highlight-color: transparent; }
button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid var(--color-primary-soft); outline-offset: 2px; }

.app-shell { width: min(100% - 32px, 960px); margin: 0 auto; padding: var(--space-6) 0 96px; }
.app-header, .form-panel__heading { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); }
.app-header { margin-bottom: var(--space-6); }
h1, h2, p { margin: 0; }
h1 { font-size: clamp(2rem, 7vw, 2.75rem); letter-spacing: -0.04em; }
h2 { font-size: 1.125rem; letter-spacing: -0.02em; }
p { color: var(--color-text-secondary); line-height: 1.5; }
.eyebrow { margin-bottom: var(--space-2); color: var(--color-text-secondary); font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }

.app-card, .form-panel { padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface); }
.app-card { display: grid; gap: var(--space-3); }
.day-summary { margin-bottom: var(--space-4); background: var(--color-primary-soft); border-color: transparent; }
.day-summary h2 { font-size: 1.5rem; }
.content-grid { display: grid; gap: var(--space-4); }

.app-button { width: fit-content; min-height: 44px; border: 1px solid transparent; border-radius: var(--radius-button); padding: 0 var(--space-4); cursor: pointer; font-weight: 700; }
.app-button--primary { color: #fff; background: var(--color-primary); }
.app-button--secondary { color: var(--color-text); border-color: var(--color-border); background: var(--color-surface); }
.app-button:hover { filter: brightness(.96); }

.status-indicator { width: fit-content; padding: var(--space-1) var(--space-2); border-radius: 999px; font-size: .8125rem; font-weight: 700; }
.status-indicator--warning { color: var(--color-warning); background: #fff4df; }
.status-indicator--success { color: var(--color-success); background: #e7f4ee; }
.status-indicator--neutral { color: var(--color-text-secondary); background: #eef1f5; }

.form-panel { display: grid; gap: var(--space-5); margin-top: var(--space-4); }
.form-panel form { display: grid; gap: var(--space-4); }
.form-grid { display: grid; gap: var(--space-4); }
.app-field { display: grid; gap: var(--space-2); }
.app-field label { font-size: .875rem; font-weight: 700; }
.app-field input, .app-field select { width: 100%; min-height: 44px; border: 1px solid var(--color-border); border-radius: var(--radius-button); padding: 0 var(--space-3); color: var(--color-text); background: var(--color-surface); }
.app-field input[aria-invalid="true"] { border-color: #b54747; }
.app-field__help { font-size: .8125rem; }
.app-field__help--error { color: #b54747; }

.bottom-navigation { position: fixed; right: 0; bottom: 0; left: 0; display: flex; justify-content: center; gap: var(--space-5); padding: var(--space-3) var(--space-4); border-top: 1px solid var(--color-border); background: rgba(255, 255, 255, .96); }
.bottom-navigation a, .bottom-navigation span { color: var(--color-text-secondary); font-size: .75rem; text-decoration: none; }
.bottom-navigation a { color: var(--color-primary); font-weight: 700; }
.bottom-navigation [aria-disabled="true"] { opacity: .58; }

@media (min-width: 640px) {
  .app-shell { padding-top: 48px; }
  .content-grid { grid-template-columns: repeat(2, 1fr); }
  .form-grid { grid-template-columns: repeat(2, 1fr); }
  .bottom-navigation { position: static; width: min(100% - 32px, 960px); margin: 0 auto var(--space-6); border: 0; background: transparent; }
}
